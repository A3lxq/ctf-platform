# Copy to .env and fill in, or just run ./scripts/start-compose.sh which
# generates all of this for you on first run. Never commit the real .env.

# This host's real reachable address (public IP or domain) -- NOT
# 127.0.0.1 unless you're only ever testing from this same machine.
# Getting this wrong silently breaks every player's connection to every
# box instance.
PUBLIC_ADDRESS=127.0.0.1

# Shared secret between ctf-platform and ctf-orchestrator -- generate
# with: openssl rand -hex 32
ORCHESTRATOR_AUTH_TOKEN=

# Admin login for ctf-platform's web UI.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs ctf-platform's session cookies -- generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional: raise/lower the per-team concurrent-instance cap (default 4).
ORCHESTRATOR_MAX_INSTANCES_PER_TEAM=4
